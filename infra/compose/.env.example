# Aionix Connect Server — environment template.
#
# Copy to the server's config directory (production: /opt/aionix-connect/config/.env,
# mode 0600) and replace every "change-me" value. Never commit the real file.
# infra/scripts/generate-config.sh (Ubuntu) and infra/local/staging.ps1 (Windows)
# generate it with random secrets.
#
# Every service validates its variables at startup and refuses to start, listing all
# problems at once, when something is missing or invalid.

# --- Release / layout -------------------------------------------------------------
AIONIX_VERSION=dev
AIONIX_SOURCE_DIR=/opt/aionix-connect/current/src
AIONIX_CONFIG_DIR=/opt/aionix-connect/config
AIONIX_DATA_DIR=/opt/aionix-connect/data
AIONIX_LOG_DIR=/opt/aionix-connect/logs

# --- Public endpoint ----------------------------------------------------------------
# Caddy site address: a DNS name for automatic HTTPS (production), ":80" for plain HTTP
# (staging on a LAN / Docker Desktop).
AIONIX_SITE_ADDRESS=connect.example.com
ACME_EMAIL=ops@example.com
AIONIX_HTTP_PORT=80
AIONIX_HTTPS_PORT=443
# Relay URL(s) handed to devices. With the single-hostname layout this is the public URL.
AIONIX_RELAY_URLS=https://connect.example.com
AIONIX_SERVER_NAME=Aionix Connect

# --- Secrets (generated; at least 24 characters) -----------------------------------
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis

# Token signing: the private key lives in ${AIONIX_CONFIG_DIR}/secrets/token-signing.key
# (never in this file). Its public key goes here for signaling and relay:
#   docker compose --profile tools run --rm aionix-admin public-key --key-file /run/secrets/token_signing_key
AIONIX_TOKEN_PUBLIC_KEYS=change-me-public-key
# During a key rotation: the retired public key(s), still accepted for a while.
AIONIX_TOKEN_PREVIOUS_PUBLIC_KEYS=

# --- Behaviour ----------------------------------------------------------------------
AIONIX_REDIS_PREFIX=aionix
AIONIX_ALLOW_QUICK_SUPPORT=true
AIONIX_OFFER_TIMEOUT_SECS=15
# 0 = unlimited per-client relay receive bandwidth (bytes/second).
AIONIX_RELAY_CLIENT_RX_BYTES_PER_SEC=0
AIONIX_RELAY_CONNECT_LIMIT_PER_MINUTE=120
AIONIX_RELAY_MAX_CONNECTIONS=10000
AIONIX_LOG=info,sqlx=warn
# Networks whose X-Forwarded-For is trusted (the Docker networks Caddy lives in).
AIONIX_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1/32

# --- Backups ------------------------------------------------------------------------
AIONIX_BACKUP_KEEP=14
# Optional: file containing a passphrase; backups are then AES-256 encrypted.
AIONIX_BACKUP_PASSPHRASE_FILE=
