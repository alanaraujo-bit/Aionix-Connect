# DEVELOPMENT ONLY: the routes of infra/compose/Caddyfile in front of the natively running
# services (infra/local/native-stack.ps1), so API, signaling and relay share one address —
# the address a public tunnel (infra/local/public-tunnel.ps1) exposes.
{
	admin off
	auto_https off
	# Only cloudflared (local) talks to it: no firewall exposure.
	default_bind 127.0.0.1
}

:18088 {
	@signal path /v1/signal
	handle @signal {
		reverse_proxy 127.0.0.1:18081
	}

	@relay path /relay /relay/* /ping /generate_204
	handle @relay {
		reverse_proxy 127.0.0.1:13340 {
			flush_interval -1
		}
	}

	handle /v1/* {
		reverse_proxy 127.0.0.1:18080
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:18080
	}

	handle {
		respond 404
	}
}
